# Build-time settings for a Journal build with accounts and sync (docs/runbooks/journal-setup.md).
# Leave these unset for the local-only build that GitHub Pages serves.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
# Display prices are the owner's decision (BRIEF §9).
VITE_JOURNAL_PRICE_MONTHLY=
VITE_JOURNAL_PRICE_ANNUAL=
